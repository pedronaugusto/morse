.{
    .name = .morse,
    .version = "0.7.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0xaa7aa068a1c6a938,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "bench",
        "ci",
        "conformance",
        "examples",
        ".github",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },

    .dependencies = .{
        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight#f6a5191c42d8de76ab758465bf897e7acee931d9",
            .hash = "preflight-0.1.0-LX1Zwv2WBQABkEzFUf5-MzYCtr0SSYHZrV097Vir7DYQ",
            .lazy = true,
        },
        // The tests' corpus entries and repeated text, asked for only in
        // morse's own tree: nothing a consumer builds names it.
        .shakedown = .{
            .url = "git+https://github.com/pedronaugusto/shakedown#4f590164cf91ef9f244ee26b0a20444b9ecdcdae",
            .hash = "shakedown-0.1.0-BR8U47zBAwCoNKX4gYuShFo5o5tCR_GSyQ3PVjzPDoPw",
            .lazy = true,
        },

        // The emulator the conformance step feeds. Lazy, so nothing is fetched
        // by a build that does not run that step: the module a consumer imports
        // has no dependencies and this changes nothing about it. Pinned to a
        // commit rather than to a tag, because the step is a claim about the
        // bytes one revision of one emulator accepted. The commit is the head of
        // ghostty's `zig-0.17` branch (ghostty-org/ghostty#14519) until that
        // port reaches its main.
        .emulator = .{
            .url = "git+https://github.com/ghostty-org/ghostty#5147c0a503cdeed7615cce245cdd815ed7a6b692",
            .hash = "ghostty-1.3.2-dev-5UdBC-lZeAVJbemF7Fz8y5ApP0uA6wTc2uzECn3c6Z_Y",
            .lazy = true,
        },
    },
}
