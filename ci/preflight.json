{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig"
  ],
  "test_support": [
    "src/testing/*"
  ],
  "function_exceptions": {
    "src/key.zig:frameEscape": {
      "lines": 129,
      "reason": "Existing implementation at adoption; this exact bound cannot grow and shrinks when the function is split."
    }
  },
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/quickstart.zig",
      "region": "usage",
      "imports": [
        "std",
        "morse"
      ]
    }
  },
  "ziglint_exceptions": "ci/ziglint-exceptions.json",
  "extra_checks": [
    [
      "zig",
      "build",
      "check-clocks"
    ]
  ],
  "unreachable_exceptions": "ci/unreachable-exceptions.json",
  "debug_print_exceptions": "ci/debug-print-exceptions.json",
  "file_name_exceptions": "ci/file-name-exceptions.json"
}
